<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Posts</h1>
        <a
            href="/posts/create"
            class="btn btn-primary"
        >
            Crear Post
        </a>
    </div>

    <%- include('../partials/messages') %>

    <% if(posts.length === 0) { %>
        <div class="alert alert-info">
            No existen posts registrados.
        </div>
    <% } %>


    <% posts.forEach(post => { %>
        <div class="card mb-3 shadow-sm">
            <div class="card-body">
                <h4 class="card-title">
                    <%= post.title %>
                </h4>

                <p class="card-text">
                    <%= post.body %>
                </p>

                <a href="/posts/<%= post.id %>" class="btn btn-info">
                    Ver
                </a>

                <a href="/posts/<%= post.id %>/edit" class="btn btn-warning">
                    Editar
                </a>

                <form                    action="/posts/<%= post.id %>/delete" method="POST" class="d-inline">

                    <button
                        class="btn btn-danger"
                        onclick="return confirm('¿Seguro que deseas eliminar este post?')">
                        Eliminar
                    </button>
                </form>
            </div>
        </div>

    <% }) %>

</div>

<%- include('../partials/footer') %>